# Copy to .env.local and fill from the Firebase console.
# Never commit .env, .env.local, or .env.*.local — those names are gitignored.
# Leave values empty in this example. Do not put real keys or debug tokens here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key. Required for production cloud calls.
# Leave empty in dev to use the App Check debug token instead.
# Placeholder only. Do not put a real site key in this file.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=
